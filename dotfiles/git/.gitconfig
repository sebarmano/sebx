[user]
	# Set name/email in ~/.gitconfig.local — never in this repo.
	# [include] below will merge it in.

[include]
	path = ~/.gitconfig.local

[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[alias]
	st  = status
	co  = checkout
	br  = branch
	lg  = log --oneline --graph --decorate --all
	undo = reset --soft HEAD~1
	wip  = !git add -A && git commit -m 'wip'
